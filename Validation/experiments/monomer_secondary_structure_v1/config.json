  "methods": {
    "primary_endpoint": "within-trajectory mean P-SEA H/S/C fractions over cycles 01\u201305, then equal weight across trajectories",
    "secondary_endpoints": [
      "cycle-05 fractions",
      "per-residue pLDDT",
      "long uncertain coil runs",
      "initialization acceptance and exhaustion",
      "attempt count",
      "wall time including initialization"
    ],
    "missing_data": "report all ten declared trajectories, including exhaustion; conditional fold metrics explicitly label n; do not replace failed seeds",
    "paired_contrasts": "each arm vs its declared reference, paired by global trajectory index",
    "design": "one-factor screening at declared settings; no exhaustive continuous sweep or full interaction factorial",
    "inspection": "applies to beta only; criterion values are prospective exploratory settings, not validated folding/disorder cutoffs",
    "pilot": "trajectory 1 is the operational smoke and remains in the final n=10; continue the remaining 9 only after integrity audit"
  },
