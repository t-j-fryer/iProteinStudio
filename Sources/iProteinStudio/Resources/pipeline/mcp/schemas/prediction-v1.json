{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iprotein://schemas/prediction-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "request"],
  "properties": {
    "project": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predictors", "jobs"],
      "properties": {
        "predictors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["boltz", "intellifold", "protenix-v2", "protenix-mini", "openfold-3-mlx"]}},
        "intellifold_model": {"enum": ["v2-flash", "v2"], "default": "v2-flash"},
        "use_potentials": {"type": "boolean", "default": false},
        "affinity": {"type": "boolean", "default": false},
        "offline_only": {"type": "boolean", "default": false},
        "num_seeds": {"type": "integer", "minimum": 1, "maximum": 20, "default": 1},
        "diffusion_samples": {"type": "integer", "minimum": 0, "maximum": 20, "default": 0},
        "max_parallel": {"type": "integer", "minimum": 0, "maximum": 128, "default": 0},
        "batch_size": {"type": "integer", "minimum": 0, "maximum": 1024, "default": 0},
        "jobs": {
          "type": "array", "minItems": 1, "maxItems": 10000,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "chains"],
            "properties": {
              "name": {"type": "string"},
              "chains": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["id", "kind"],
                  "properties": {
                    "id": {"type": "string"}, "kind": {"enum": ["protein", "ligand"]},
                    "sequence": {"type": "string"}, "smiles": {"type": "string"},
                    "msa": {"type": "string", "default": "auto"}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
