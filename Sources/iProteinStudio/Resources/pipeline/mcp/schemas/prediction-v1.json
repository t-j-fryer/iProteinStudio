{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iprotein://schemas/prediction-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "request"
  ],
  "properties": {
    "project": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predictors",
        "jobs"
      ],
      "properties": {
        "predictors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "boltz",
              "intellifold",
              "protenix-v2",
              "protenix-mini",
              "openfold-3-mlx",
              "esmfold2-full-mlx",
              "esmfold2-fast-mlx"
            ]
          }
        },
        "intellifold_model": {
          "enum": [
            "v2-flash",
            "v2"
          ],
          "default": "v2-flash"
        },
        "use_potentials": {
          "type": "boolean",
          "default": false
        },
        "affinity": {
          "type": "boolean",
          "default": false
        },
        "offline_only": {
          "type": "boolean",
          "default": false
        },
        "num_seeds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 1
        },
        "diffusion_samples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "default": 0
        },
        "max_parallel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128,
          "default": 0
        },
        "batch_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024,
          "default": 0
        },
        "jobs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "chains"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "chains": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "kind"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "protein",
                        "ligand"
                      ]
                    },
                    "sequence": {
                      "type": "string"
                    },
                    "smiles": {
                      "type": "string"
                    },
                    "msa": {
                      "type": "string",
                      "default": "auto"
                    }
                  }
                }
              }
            }
          }
        },
        "template": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "chains"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "chains": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "mode": {
              "enum": [
                "guide"
              ],
              "default": "guide"
            }
          },
          "description": "Optional structure guidance for selected protein chains in every fold. Boltz, IntelliFold or Protenix v2 only."
        },
        "prediction_settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "boltz": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "msa_depth": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000,
                  "default": 128
                },
                "diffusion_steps": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000,
                  "default": 25
                },
                "recycles": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000,
                  "default": 3
                }
              }
            },
            "intellifold": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "msa_depth": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000,
                  "default": 128
                },
                "diffusion_steps": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000,
                  "default": 25
                },
                "recycles": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000,
                  "default": 10
                }
              }
            },
            "intellifold-full": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "msa_depth": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000,
                  "default": 128
                },
                "diffusion_steps": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000,
                  "default": 25
                },
                "recycles": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000,
                  "default": 10
                }
              }
            },
            "protenix-v2": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "msa_depth": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000,
                  "default": 128
                },
                "diffusion_steps": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000,
                  "default": 25
                },
                "recycles": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000,
                  "default": 10
                }
              }
            },
            "protenix-mini": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "msa_depth": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000,
                  "default": 128
                },
                "diffusion_steps": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000,
                  "default": 5
                },
                "recycles": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000,
                  "default": 4
                }
              }
            },
            "protenix-constraint-v0.5": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "msa_depth": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000,
                  "default": 128
                },
                "diffusion_steps": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000,
                  "default": 25
                },
                "recycles": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000,
                  "default": 10
                }
              }
            },
            "openfold-3-mlx": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "msa_depth": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000,
                  "default": 128
                },
                "diffusion_steps": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000,
                  "default": 25
                },
                "recycles": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000,
                  "default": 3
                }
              }
            },
            "esmfold2-full-mlx": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "msa_depth": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000,
                  "default": 128
                },
                "diffusion_steps": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000,
                  "default": 100
                },
                "recycles": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000,
                  "default": 20
                }
              }
            },
            "esmfold2-fast-mlx": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "msa_depth": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000,
                  "default": 0
                },
                "diffusion_steps": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000,
                  "default": 50
                },
                "recycles": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000,
                  "default": 3
                }
              }
            }
          },
          "description": "Per-engine scientific overrides. Defaults: MSA 128 and 25 diffusion steps; Mini 5/4, ESMFold2 Full 50/3, Fast sequence-only 50/3. Depth 0 preserves the supplied alignment. Existing saved jobs retain their frozen settings."
        }
      }
    }
  }
}
