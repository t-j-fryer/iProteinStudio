{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iprotein://schemas/target-prepare-v1.json",
  "title": "iProteinStudio target preparation request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "predictors",
    "sequences"
  ],
  "properties": {
    "project": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "predictors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "boltz",
          "intellifold",
          "protenix-v2",
          "protenix-mini",
          "openfold-3-mlx",
          "esmfold2-full-mlx",
          "esmfold2-fast-mlx"
        ]
      }
    },
    "sequences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "sequence": {
            "type": "string"
          }
        }
      }
    },
    "intellifold_model": {
      "enum": [
        "v2-flash",
        "v2"
      ]
    },
    "offline_only": {
      "type": "boolean"
    },
    "num_seeds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "diffusion_samples": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "max_parallel": {
      "type": "integer",
      "minimum": 0
    },
    "batch_size": {
      "type": "integer",
      "minimum": 0
    },
    "prediction_settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "boltz": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "msa_depth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "default": 128
            },
            "diffusion_steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 25
            },
            "recycles": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000,
              "default": 3
            }
          }
        },
        "intellifold": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "msa_depth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "default": 128
            },
            "diffusion_steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 25
            },
            "recycles": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000,
              "default": 10
            }
          }
        },
        "intellifold-full": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "msa_depth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "default": 128
            },
            "diffusion_steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 25
            },
            "recycles": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000,
              "default": 10
            }
          }
        },
        "protenix-v2": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "msa_depth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "default": 128
            },
            "diffusion_steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 25
            },
            "recycles": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000,
              "default": 10
            }
          }
        },
        "protenix-mini": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "msa_depth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "default": 128
            },
            "diffusion_steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 5
            },
            "recycles": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000,
              "default": 4
            }
          }
        },
        "protenix-constraint-v0.5": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "msa_depth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "default": 128
            },
            "diffusion_steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 25
            },
            "recycles": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000,
              "default": 10
            }
          }
        },
        "openfold-3-mlx": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "msa_depth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "default": 128
            },
            "diffusion_steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 25
            },
            "recycles": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000,
              "default": 3
            }
          }
        },
        "esmfold2-full-mlx": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "msa_depth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "default": 128
            },
            "diffusion_steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 100
            },
            "recycles": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000,
              "default": 20
            }
          }
        },
        "esmfold2-fast-mlx": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "msa_depth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "default": 0
            },
            "diffusion_steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 50
            },
            "recycles": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000,
              "default": 3
            }
          }
        }
      },
      "description": "Per-engine scientific overrides. Defaults: MSA 128 and 25 diffusion steps; Mini 5/4, ESMFold2 Full 100/20, Fast sequence-only 50/3. Depth 0 preserves the supplied alignment. Existing saved jobs retain their frozen settings."
    }
  }
}
