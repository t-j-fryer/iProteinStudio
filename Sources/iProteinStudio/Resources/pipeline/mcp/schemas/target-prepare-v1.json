{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iprotein://schemas/target-prepare-v1.json",
  "title": "iProteinStudio target preparation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "predictors", "sequences"],
  "properties": {
    "project": {"type": "string"},
    "name": {"type": "string"},
    "predictors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["boltz", "intellifold", "protenix-v2", "protenix-mini", "openfold-3-mlx"]}
    },
    "sequences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence"],
        "properties": {
          "id": {"type": "string"},
          "sequence": {"type": "string"}
        }
      }
    },
    "intellifold_model": {"enum": ["v2-flash", "v2"]},
    "offline_only": {"type": "boolean"},
    "num_seeds": {"type": "integer", "minimum": 1, "maximum": 20},
    "diffusion_samples": {"type": "integer", "minimum": 0, "maximum": 20},
    "max_parallel": {"type": "integer", "minimum": 0},
    "batch_size": {"type": "integer", "minimum": 0}
  }
}
