{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iprotein://schemas/iterative-design-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "template_path",
    "arguments"
  ],
  "properties": {
    "project": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "run_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "template_path": {
      "type": "string",
      "minLength": 1
    },
    "monomer_control_benchmark": {
      "type": "boolean",
      "default": false,
      "description": "Validate an unconditioned monomer and use the same recorded per-run scheduler across controls."
    },
    "target_template_path": {
      "type": "string",
      "minLength": 1
    },
    "target_template_mode": {
      "type": "string",
      "enum": [
        "guide"
      ],
      "default": "guide"
    },
    "arguments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 120,
      "description": "Runner arguments. Pin predictor seed and samples with --predictor-seed and --predictor-samples. The only secondary-structure control is --negative-helix-constant: finite 0..1 strength, applied only during initialization; 0 disables it. Beta, mixed, sustained bias, loop-kill and inspection flags are rejected.",
      "items": {
        "type": "string"
      }
    },
    "environment_overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "LASERMPNN_SEQ_TEMP": {
          "type": "string"
        },
        "LASERMPNN_FS_TEMP": {
          "type": "string"
        }
      }
    }
  }
}
