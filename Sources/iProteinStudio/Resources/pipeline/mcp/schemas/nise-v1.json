{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "request"
  ],
  "properties": {
    "project": {
      "type": "string"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "smiles"
      ],
      "properties": {
        "smiles": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "scheduler": {
          "enum": [
            "cycle-wave",
            "resident"
          ]
        },
        "preorganisation": {
          "type": "boolean"
        },
        "num_starts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "default": 1000,
          "description": "Total independent initial backbone attempts across all lengths."
        },
        "trajectories": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 8
        },
        "nise_seqs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096,
          "default": 32,
          "description": "Maximum proposals per retained parent per cycle; adaptive sampling starts smaller and tops up to this cap."
        },
        "max_cycles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 30
        },
        "patience": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 4
        },
        "binder_min_len": {
          "type": "integer",
          "minimum": 60,
          "maximum": 250,
          "default": 65
        },
        "binder_max_len": {
          "type": "integer",
          "minimum": 60,
          "maximum": 250,
          "default": 150
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "default": 0
        },
        "top_x": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 8
        },
        "phase0_refine_cycles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "default": 2
        },
        "phase0_seqs1": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024,
          "default": 3
        },
        "phase0_seqs2": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024,
          "default": 5
        },
        "beam": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 3,
          "description": "Maximum Boltz-passing sequences advanced per trajectory per cycle."
        },
        "nesso_top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096,
          "default": 16,
          "description": "Maximum newly sampled candidates folded per trajectory per proposal round; adaptive rounds pool folded results."
        },
        "nesso_screen": {
          "type": "boolean",
          "default": false,
          "description": "Experimental NESSO prescreen of optimization sequences before Boltz; never used for initial backbone generation."
        },
        "backbone_method": {
          "enum": [
            "protein-hunter",
            "rfdiffusion3"
          ],
          "default": "protein-hunter",
          "description": "Generator for initial backbones; later NISE refinement and optimisation are shared."
        },
        "rfd3_num_bins": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 5,
          "description": "Evenly spaced RFdiffusion3 binder lengths; capped by starts and distinct lengths. One group uses midpoint."
        },
        "hotspot_atoms": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{1,2}[1-9][0-9]{0,2}$",
            "maxLength": 4
          },
          "uniqueItems": true,
          "maxItems": 256,
          "default": []
        },
        "exposed_atoms": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{1,2}[1-9][0-9]{0,2}$",
            "maxLength": 4
          },
          "uniqueItems": true,
          "maxItems": 256,
          "default": []
        },
        "hotspot_distance": {
          "type": "number",
          "minimum": 3,
          "maximum": 10,
          "default": 6.0
        },
        "exposure_min_fraction": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1,
          "default": 0.5
        },
        "ligand_atom_signature": {
          "type": "string",
          "description": "SHA-256 signature from the NISE ligand resolver; required for selected atoms."
        },
        "ligand_atoms_generated_for": {
          "type": "string",
          "description": "Exact original SMILES for which atom selections were resolved."
        },
        "phase0_nesso_screen": {
          "type": "boolean",
          "default": false
        },
        "phase0_nesso_refine_top_k": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "maximum": 1024
        },
        "phase0_nesso_expand_top_k": {
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "maximum": 10000
        },
        "phase0_gate_seqs": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 1024
        },
        "phase0_sc_ca": {
          "type": "number",
          "default": 2.0,
          "minimum": 0.1,
          "maximum": 10
        },
        "nise_sc_ca": {
          "type": "number",
          "default": 2.5,
          "minimum": 0.1,
          "maximum": 10
        },
        "nise_sc_lig": {
          "type": "number",
          "default": 2.5,
          "minimum": 0.1,
          "maximum": 10
        },
        "nise_ligand_sc_from_cycle": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 1001
        },
        "search_policy_version": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 3
        },
        "early_score_gate": {
          "type": "number",
          "default": 0.8,
          "minimum": 0,
          "maximum": 2
        },
        "min_improvement": {
          "type": "number",
          "default": 0.01,
          "minimum": 0,
          "maximum": 1
        },
        "initial_proposals": {
          "type": "integer",
          "default": 16,
          "minimum": 1,
          "maximum": 4096
        },
        "affinity_batch_size": {
          "type": "integer",
          "default": 8,
          "minimum": 1,
          "maximum": 128
        },
        "adaptive_proposals": {
          "type": "boolean",
          "default": false
        },
        "selective_affinity": {
          "type": "boolean",
          "default": true
        },
        "first_cycle_seqs": {
          "type": "integer",
          "default": 64,
          "minimum": 1,
          "maximum": 4096
        },
        "noise_predictions": {
          "type": "integer",
          "default": 32,
          "minimum": 1,
          "maximum": 1024
        },
        "noise_mpnn_seqs": {
          "type": "integer",
          "default": 32,
          "minimum": 1,
          "maximum": 4096
        },
        "noise_advance": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "maximum": 63
        },
        "noise_radius": {
          "type": "number",
          "default": 6.0,
          "minimum": 3,
          "maximum": 15
        },
        "noise_percent": {
          "type": "number",
          "default": 25.0,
          "minimum": 1,
          "maximum": 100
        },
        "partial_noising": {
          "type": "boolean",
          "default": false,
          "description": "Experimental ligand-local X-mask branch from cycle 2; replaces noise_advance ordinary sampling parents and advancement places. Default: two ordinary parents plus one repaired winner, three total places. Requires Boltz for masked predictions."
        },
        "exposure_mode": {
          "enum": [
            "sasa",
            "biotin-carboxamide-v1"
          ],
          "default": "sasa",
          "description": "Biotin protocol accepts open/restricted exits, rejects unresolved/blocked; no rotation rescue. Replaces terminal acid oxygen SASA only."
        },
        "geometry_workers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "default": 0,
          "description": "0 selects bounded automatic CPU parallelism; explicit requests are clamped to memory and core limits."
        },
        "screening_engine": {
          "type": "string",
          "enum": [
            "nesso",
            "psichic"
          ],
          "default": "nesso",
          "description": "Experimental sequence shortlist engine. PSICHIC ranks 1\u2212nonbinder; Boltz still performs structural verification and final selection."
        },
        "scoring_mode": {
          "type": "string",
          "enum": [
            "boltz",
            "screening"
          ],
          "default": "boltz",
          "description": "Boltz selection after optional prescreen, or selected sequence scorer as objective with Boltz geometry only."
        },
        "nesso_early_score_gate": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 0.4,
          "description": "NESSO-objective cycle01 cutoff; zero disables. No calibrated replacement for Boltz 0.80."
        },
        "psichic_early_score_gate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.2,
          "description": "PSICHIC-objective cycle01 cutoff; zero disables. Independent of NESSO/Boltz gates."
        }
      }
    },
    "restart_from": {
      "type": "string",
      "description": "Optional source NISE directory name in this project. Import audited matching cycle00 Protein Hunter structures into a new immutable campaign; recalculate all geometry and advancement."
    }
  }
}
