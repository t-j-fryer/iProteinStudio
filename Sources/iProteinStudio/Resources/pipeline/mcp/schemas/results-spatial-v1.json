{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string"
    },
    "candidate_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": 1
        },
        "mode": {
          "enum": [
            "protein",
            "ligand"
          ]
        },
        "binderChains": {
          "type": "string"
        },
        "targetChain": {
          "type": "string"
        },
        "residues": {
          "type": "string"
        },
        "ligandResidue": {
          "type": "string"
        },
        "atoms": {
          "type": "string"
        },
        "cutoff": {
          "type": "string",
          "maxLength": 32
        },
        "coverage": {
          "enum": [
            "all",
            "any"
          ]
        },
        "requireGeometry": {
          "type": "boolean"
        },
        "minimumBurial": {
          "type": "string",
          "maxLength": 32
        },
        "maximumBurial": {
          "type": "string",
          "maxLength": 32
        }
      },
      "required": [
        "schema",
        "mode",
        "binderChains",
        "targetChain",
        "residues",
        "ligandResidue",
        "atoms",
        "cutoff",
        "coverage",
        "requireGeometry",
        "minimumBurial",
        "maximumBurial"
      ]
    },
    "artifact_index": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "run_id",
    "candidate_ids",
    "snapshot_sha256",
    "policy"
  ]
}
