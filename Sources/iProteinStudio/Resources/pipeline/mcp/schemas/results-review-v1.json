{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string"
    },
    "metric": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "all",
        "saved",
        "custom"
      ],
      "default": "all"
    },
    "rules": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "metric": {
            "type": "string"
          },
          "comparison": {
            "enum": [
              ">=",
              "<=",
              ">",
              "<"
            ]
          },
          "threshold": {
            "type": "number"
          }
        },
        "required": [
          "metric",
          "comparison",
          "threshold"
        ]
      }
    },
    "descending": {
      "type": "boolean",
      "default": true
    },
    "max_per_family": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "predictor": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "spatial_job_id": {
      "type": "string"
    }
  },
  "required": [
    "run_id"
  ]
}
