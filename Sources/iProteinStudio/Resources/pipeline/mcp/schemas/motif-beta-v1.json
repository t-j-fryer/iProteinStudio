{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "run_name",
    "request"
  ],
  "properties": {
    "project": {
      "type": "string"
    },
    "run_name": {
      "type": "string"
    },
    "memory_policy": {
      "enum": [
        "enforce",
        "override"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": 1
        },
        "profile": {
          "const": "studio-ame-beta-v2"
        },
        "case_id": {
          "type": "string"
        },
        "stage": {
          "enum": [
            "prepare",
            "backbones",
            "cycles"
          ]
        },
        "engine": {
          "enum": [
            "boltz",
            "protenix-v2",
            "intellifold"
          ]
        },
        "guidance": {
          "type": "boolean"
        },
        "guidance_source": {
          "enum": [
            "rfd3-root",
            "benchmark-residues"
          ]
        },
        "ligand_profile": {
          "const": "fixedligand"
        },
        "source_tolerance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2.5
        },
        "length": {
          "type": "integer",
          "minimum": 50,
          "maximum": 400
        },
        "roots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "cycles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "proposals": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "beam_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "policies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "fixed",
              "iterative",
              "greedy",
              "beam"
            ]
          }
        },
        "designers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ligandmpnn",
              "lasermpnn"
            ]
          }
        }
      }
    }
  }
}
