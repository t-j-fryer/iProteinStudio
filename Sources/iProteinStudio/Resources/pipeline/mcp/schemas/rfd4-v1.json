{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "run_name",
    "request"
  ],
  "properties": {
    "project": {
      "type": "string"
    },
    "run_name": {
      "type": "string"
    },
    "memory_policy": {
      "enum": [
        "enforce",
        "override"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "integer",
          "default": 1
        },
        "task": {
          "type": "string",
          "default": "monomer",
          "enum": [
            "monomer",
            "protein",
            "ligand",
            "nanobody",
            "motif",
            "partial",
            "inverse",
            "annotated"
          ]
        },
        "source": {
          "type": "string",
          "default": "",
          "description": "Target PDB/CIF or annotated native input. Protein/nanobody workflows retain all non-water, noncovalent ligand instances with their source chemistry and atom identities; every prediction includes them. Covalent polymer\u2013ligand links and nucleic-acid context require a separate workflow."
        },
        "length": {
          "type": "integer",
          "default": 120,
          "minimum": 1,
          "maximum": 2000
        },
        "count": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "maximum": 10000
        },
        "seed": {
          "type": "integer",
          "default": 42,
          "minimum": 0,
          "maximum": 4294967295
        },
        "target_chain": {
          "type": "string",
          "default": "B"
        },
        "binder_chain": {
          "type": "string",
          "default": "A"
        },
        "hotspots": {
          "type": "array",
          "default": [],
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "contig": {
          "type": "string",
          "default": ""
        },
        "conditions": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "condition",
              "value",
              "selection"
            ],
            "properties": {
              "condition": {
                "enum": [
                  "C_CRD",
                  "C_SEQ",
                  "C_IDX",
                  "C_CRDGRP",
                  "C_CENTROID",
                  "C_HOT",
                  "C_RAS",
                  "C_SEC",
                  "C_HB",
                  "C_PISTACK",
                  "C_PICATION",
                  "C_SALT",
                  "C_HPHOB",
                  "C_MCOORD",
                  "C_CATH"
                ]
              },
              "value": {
                "type": [
                  "boolean",
                  "number",
                  "string"
                ]
              },
              "selection": {
                "type": "string"
              },
              "group": {
                "type": "integer"
              }
            }
          }
        },
        "partial_fraction": {
          "type": "number",
          "default": 0.5
        },
        "search": {
          "type": "string",
          "default": "native",
          "enum": [
            "native",
            "fixed",
            "iterative",
            "greedy",
            "beam"
          ]
        },
        "cycles": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 100
        },
        "proposals": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "maximum": 64
        },
        "beam_width": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "maximum": 64
        },
        "sequence_model": {
          "type": "string",
          "default": "solublempnn"
        },
        "predictor": {
          "type": "string",
          "default": "esmfold2-full-mlx",
          "enum": [
            "esmfold2-full-mlx",
            "esmfold2-fast-mlx",
            "esmfold2-600-mlx",
            "boltz",
            "intellifold",
            "intellifold-full",
            "protenix-v2",
            "protenix-mini",
            "protenix-constraint-v0.5",
            "openfold-3-mlx"
          ]
        },
        "target_msa": {
          "type": "string",
          "default": ""
        },
        "scaffold_msa": {
          "type": "string",
          "default": ""
        },
        "cdr_ranges": {
          "type": "string",
          "default": ""
        },
        "omit_amino_acids": {
          "type": "string",
          "default": ""
        },
        "temperature": {
          "type": "number",
          "default": 0.1
        },
        "optimized_kernels": {
          "type": "boolean",
          "default": false
        },
        "annotated_input": {
          "type": "boolean",
          "default": false
        },
        "assess_native": {
          "type": "boolean",
          "default": false
        },
        "starting_structures": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "source_target_chain": {
          "type": "string",
          "default": ""
        },
        "native_search": {
          "type": "boolean",
          "default": false
        },
        "native_beam_width": {
          "type": "integer",
          "default": 2
        },
        "native_branches": {
          "type": "integer",
          "default": 2
        },
        "native_checkpoints": {
          "type": "array",
          "default": [
            8,
            15
          ],
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          }
        },
        "native_partial_fraction": {
          "type": "number",
          "default": 0.5
        },
        "ligand_smiles": {
          "type": "string",
          "default": ""
        },
        "time_budget_minutes": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "maximum": 10080
        },
        "scaffold_id": {},
        "hotspot_residues": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Chain-qualified source residues, e.g. B32 C55. Required instead of bare numbers for multiple target chains."
        },
        "length_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum",
            "maximum"
          ],
          "properties": {
            "minimum": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            },
            "maximum": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            },
            "counts": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            }
          }
        },
        "hit_filters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ipsae_min": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "iptm": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "complex_plddt": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "selection_metric": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "ipsae_min",
            "iptm",
            "ptm",
            "complex_plddt",
            "pbind_ligand_plddt",
            "pbind",
            "ligand_plddt"
          ],
          "description": "Maximize this measured score during sequence search. Null retains the task default. Missing requested scores stop selection. Native rollout search uses the same selected score through upstream reward aggregation."
        },
        "scaffold_weights": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "description": "Catalogue framework IDs mapped to relative starting-family weights. Smooth weighted round-robin allocation, automatic per-framework CDRs and MSAs. Applies to newly generated nanobodies, excluding native rollout search."
        },
        "ligand_conformer": {
          "type": [
            "string",
            "null"
          ]
        },
        "ligand_conformers": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "required": [
              "label",
              "path",
              "weight"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "ligand_atom_conditions": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "array",
            "items": {
              "enum": [
                "buried",
                "exposed",
                "hotspot",
                "hbondDonor",
                "hbondAcceptor"
              ]
            }
          }
        },
        "ligand_attachment_atom": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ligand_attachment_linker_atom": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ligand_is_conjugated": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "ligand_search_pdb": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    }
  }
}
