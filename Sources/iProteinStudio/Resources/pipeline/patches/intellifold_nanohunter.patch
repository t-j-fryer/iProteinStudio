+def parse_buckets(value: str) -> tuple[int, ...]:
+    """Parse a strictly increasing comma-separated token-bucket list."""
+    try:
+        buckets = tuple(int(part.strip()) for part in value.split(",") if part.strip())
+    except ValueError as exc:
+        raise argparse.ArgumentTypeError("--buckets must contain integers") from exc
+    if not buckets or any(bucket <= 0 for bucket in buckets):
+        raise argparse.ArgumentTypeError("--buckets must contain positive integers")
+    if any(left >= right for left, right in zip(buckets, buckets[1:])):
+        raise argparse.ArgumentTypeError("--buckets must be strictly increasing")
+    return buckets
+
+
+def empty_device_cache(accelerator):
+    """Clear CUDA's allocator only when CUDA is actually in use.
