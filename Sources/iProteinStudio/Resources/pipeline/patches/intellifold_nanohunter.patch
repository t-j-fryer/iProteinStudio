+def _add_intellifold_metadata_to_mmcif(old_cif, version: str, model_id: bytes):
+  """Write valid, explicit IntelliFold identity into the AF3 ModelCIF schema.
+
+  Converted IntelliFold checkpoints inherit the AF3 schema's fixed-width empty
+  ``__identifier__`` record.  Serialising that record verbatim writes NUL bytes
+  into ``_software.version`` and produces invalid mmCIF.  The AF3-derived JAX
+  engine and ModelCIF schema remain acknowledged in the description and legal
+  header, while the model software itself is labelled as IntelliFold.
+  """
+  variant = (
+      'IntelliFold-v2-flash'
+      if os.environ.get('INTFOLD_FLASH') == '1'
+      else 'IntelliFold-v2'
+  )
+  safe_model_id = model_id.rstrip(b'\x00') or variant.encode('ascii')
+  cif = _AF3_ADD_METADATA_TO_MMCIF(
+      old_cif=old_cif, version=version, model_id=safe_model_id
+  )
+  return cif.copy_and_update({
+      '_software.name': ['IntelliFold'],
+      '_software.version': [f'{variant} JAX ({version})'],
+      '_software.description': [
+          'IntelliFold structure prediction using an AlphaFold 3-derived JAX engine'
+      ],
+      '_ma_model_list.model_group_name': [f'{variant} JAX'],
+  })
+
+
+# post_processing imports this module object, so replacing the function here
+# updates only this IntelliFold runner without editing the vendored AF3 source.
+af3_mmcif_metadata.add_metadata_to_mmcif = _add_intellifold_metadata_to_mmcif
