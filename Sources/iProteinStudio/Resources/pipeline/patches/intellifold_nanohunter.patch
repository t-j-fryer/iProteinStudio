+#!/usr/bin/env python3
+"""Convert the PyTorch IntelliFold-v2-flash checkpoint for the AF3 JAX engine.
+
+The released full-v2 converter cannot be reused unchanged: v2-flash has 12
+pairformer blocks, 6 diffusion-transformer blocks, 2 diffusion atom blocks and
+an advanced conditioning path.  This module adapts the audited AF3/IntelliFold
+schema for those differences and then uses the common binary writer.
+"""
+
+from __future__ import annotations
+
+import argparse
+import os
+import numpy as np
+
+from intellifold import convert
+
+
+_PAIRFORMER_PREFIX = (
+    'diffuser/evoformer/__layer_stack_no_per_layer_1/trunk_pairformer/'
+)
+_ATOM_PREFIXES = (
+    'diffuser/~/diffusion_head/diffusion_atom_transformer_encoder/',
+    'diffuser/~/diffusion_head/diffusion_atom_transformer_decoder/',
+)
+_TRANSFORMER_PREFIX = 'diffuser/~/diffusion_head/transformer/'
+_COND_SCOPE = 'diffuser/~/diffusion_head/'
+_FLASH_HEADS = dict(pair=4, template=4, msa=8, single=16, token=16, atom=4)
+
+
+def _zeros_like_shape(arr: np.ndarray, shape: tuple[int, ...]) -> np.ndarray:
+  return np.zeros(shape, dtype=arr.dtype)
+
+
+def build_flash_schema(recs, amap):
+  """Return schema records/correspondence for the v2-flash JAX graph."""
+  old_amap = dict(amap)
+  new_amap = {}
+  out = []
+
+  conditioning = {
+      (_COND_SCOPE + 'pair_cond_initial_norm', 'scale'):
+          ((128,), 'diffusion_module.diffusion_conditioning.layer_norm_z.weight', 'id'),
+      (_COND_SCOPE + 'pair_cond_initial_projection', 'weights'):
+          ((256, 128), 'diffusion_module.diffusion_conditioning.linear_z.weight', 'T'),
+      (_COND_SCOPE + 'single_cond_initial_norm', 'scale'):
+          ((384,), 'diffusion_module.diffusion_conditioning.layer_norm_s.weight', 'id'),
+      (_COND_SCOPE + 'single_cond_initial_projection', 'weights'):
+          ((768, 384), 'diffusion_module.diffusion_conditioning.linear_s.weight', 'T'),
+  }
+
+  for scope, name, arr in recs:
+    key = (scope, name)
+    if key in conditioning:
+      shape, pt_key, tag = conditioning[key]
+      out.append((scope, name, _zeros_like_shape(arr, shape)))
+      new_amap[(scope, name, ())] = (pt_key, tag)
+      continue
+
+    nsd = scope.count('__layer_stack')
+    shape = tuple(arr.shape)
+    if scope.startswith(_PAIRFORMER_PREFIX):
+      shape = (12,) + shape[1:]
+    elif scope in convert.ATOM_PL and scope.startswith(_ATOM_PREFIXES):
+      # Packed pair-bias projection: [pair_channels, blocks, heads].
+      shape = (shape[0], 2, shape[2])
+    elif scope.startswith(_ATOM_PREFIXES) and nsd == 1:
+      shape = (2,) + shape[1:]
+    elif scope.startswith(_TRANSFORMER_PREFIX):
+      if nsd == 2:
+        shape = (2, 3) + shape[2:]
+      elif scope == convert.DIFFTX_PL:
+        # One outer super-block axis; the inner block axis is an output dim.
+        shape = (2, shape[1], 3, shape[3])
+    out.append((scope, name, _zeros_like_shape(arr, shape)))
+
+    if nsd == 0:
+      hit = old_amap.get((scope, name, ()))
+      if hit is not None:
+        new_amap[(scope, name, ())] = hit
+    elif scope.startswith(_PAIRFORMER_PREFIX):
+      for i in range(12):
+        hit = old_amap.get((scope, name, (i,)))
+        if hit is not None:
+          new_amap[(scope, name, (i,))] = hit
+    elif scope.startswith(_ATOM_PREFIXES) and nsd == 1:
+      for i in range(2):
+        hit = old_amap.get((scope, name, (i,)))
+        if hit is not None:
+          new_amap[(scope, name, (i,))] = hit
+    elif scope.startswith(_TRANSFORMER_PREFIX) and nsd == 2:
+      for block in range(6):
+        old_idx = (block // 4, block % 4)
+        hit = old_amap.get((scope, name, old_idx))
+        if hit is not None:
+          new_amap[(scope, name, (block // 3, block % 3))] = hit
+    else:
+      for idx in np.ndindex(*shape[:nsd]):
+        hit = old_amap.get((scope, name, tuple(idx)))
+        if hit is not None:
+          new_amap[(scope, name, tuple(idx))] = hit
+
+  extras = (
+      ('pair_relpos_initial_projection', 'weights', (139, 128),
+       'diffusion_module.diffusion_conditioning.relative_positions_encoding.linear_relpos.weight', 'T'),
+      ('pair_relpos_initial_norm', 'scale', (128,),
+       'diffusion_module.diffusion_conditioning.layer_norm_z_relpos.weight', 'id'),
+      ('single_target_initial_projection', 'weights', (447, 384),
+       'diffusion_module.diffusion_conditioning.linear_s_inputs.weight', 'T'),
+      ('single_target_initial_norm', 'scale', (384,),
+       'diffusion_module.diffusion_conditioning.layer_norm_s_inputs.weight', 'id'),
+  )
+  for module, name, shape, pt_key, tag in extras:
+    scope = _COND_SCOPE + module
+    out.append((scope, name, np.zeros(shape, dtype=np.float32)))
+    new_amap[(scope, name, ())] = (pt_key, tag)
+
+  return out, new_amap
+
+
+def _coverage(pt, amap):
+  mapped = {hit[0] for hit in amap.values() if hit and hit[0] in pt}
+  mapped.update(k for k in pt if k.endswith('fourier_embedding.weight'))
+  mapped.update(k for k in pt if k.endswith('fourier_embedding.bias'))
+  # Pair-bias projections are packed specially by convert.build_pair_logits().
+  mapped.update(k for k in pt if k.endswith('attention_pair_bias.linear_z.weight'))
+  missing = sorted(set(pt) - mapped)
+  mapped_params = sum(int(np.prod(pt[k].shape)) for k in mapped)
+  total_params = sum(int(np.prod(v.shape)) for v in pt.values())
+  print(
+      f'[coverage] mapped {len(mapped)}/{len(pt)} tensors; '
+      f'{mapped_params:,}/{total_params:,} parameters '
+      f'({100 * mapped_params / total_params:.5f}%)',
+      flush=True,
+  )
+  if missing:
+    print(f'[coverage] {len(missing)} checkpoint tensors are not consumed by the JAX graph:')
+    for key in missing[:40]:
+      print(f'  {key} {tuple(pt[key].shape)}')
+  return missing, mapped_params, total_params
+
+
+def main(argv=None):
+  parser = argparse.ArgumentParser(description=__doc__)
+  parser.add_argument('--schema', required=True)
+  parser.add_argument('--flash-pt', required=True)
+  parser.add_argument('--out-dir', required=True)
+  args = parser.parse_args(argv)
+
+  os.makedirs(args.out_dir, exist_ok=True)
+  recs, amap = convert.load_schema(args.schema)
+  recs, amap = build_flash_schema(recs, amap)
+  print(f'[schema] {len(recs)} records, {len(amap)} correspondences', flush=True)
+  pt = convert.load_pt(args.flash_pt)
+  print(f'[checkpoint] {len(pt)} tensors', flush=True)
+  _coverage(pt, amap)
+
+  weights = os.path.join(args.out_dir, 'intellifold_v2_flash.bin.zst')
+  fourier = os.path.join(args.out_dir, 'intellifold_v2_flash_fourier.npz')
+  convert.convert(pt, _FLASH_HEADS, weights, recs, amap, compare=False)
+  convert.extract_fourier(pt, fourier)
+  print(f'[done] JAX v2-flash weights: {weights}', flush=True)
+  print(f'[done] Fourier embedding: {fourier}', flush=True)
+
+
+if __name__ == '__main__':
+  main()
