+
+def _flash_conditioning(
+    self,
+    batch,
+    embeddings,
+    noise_level,
+    use_conditioning,
+):
+  """IntelliFold-v2-flash's advanced diffusion conditioning in JAX.
+
+  Full IntelliFold-v2 uses the stock AF3 conditioning layout.  The flash model
+  instead projects and normalises relative-position and target features before
+  concatenating them with the trunk representations.  This is a direct JAX
+  transcription of ``DiffusionConditioning.forward`` with
+  ``advanced_conditioning=True`` in the PyTorch release.
+  """
+  from alphafold3.model.components import haiku_modules as hm
+  from alphafold3.model.network import diffusion_head
+  from alphafold3.model.network import diffusion_transformer
+  from alphafold3.model.network import featurization
+  from alphafold3.model.network import noise_level_embeddings
+  import jax.numpy as jnp
+
+  single_embedding = use_conditioning * embeddings['single']
+  pair_embedding = use_conditioning * embeddings['pair']
+
+  rel_features = featurization.create_relative_encoding(
+      seq_features=batch.token_features,
+      max_relative_idx=32,
+      max_relative_chain=2,
+  ).astype(pair_embedding.dtype)
+  rel_features = hm.Linear(
+      self.config.conditioning.pair_channel,
+      use_bias=False,
+      precision='highest',
+      name='pair_relpos_initial_projection',
+  )(rel_features)
+  pair_cond = jnp.concatenate([
+      hm.LayerNorm(
+          use_fast_variance=False,
+          create_offset=False,
+          name='pair_cond_initial_norm',
+      )(pair_embedding),
+      hm.LayerNorm(
+          use_fast_variance=False,
+          create_offset=False,
+          name='pair_relpos_initial_norm',
+      )(rel_features),
+  ], axis=-1)
+  pair_cond = hm.Linear(
+      self.config.conditioning.pair_channel,
+      use_bias=False,
+      precision='highest',
+      name='pair_cond_initial_projection',
+  )(pair_cond)
+
+  for idx in range(2):
+    pair_cond += diffusion_transformer.transition_block(
+        pair_cond, 2, self.global_config, name=f'pair_transition_{idx}'
+    )
+
+  target_cond = hm.Linear(
+      self.config.conditioning.seq_channel,
+      use_bias=False,
+      precision='highest',
+      name='single_target_initial_projection',
+  )(embeddings['target_feat'])
+  single_cond = jnp.concatenate([
+      hm.LayerNorm(
+          use_fast_variance=False,
+          create_offset=False,
+          name='single_cond_initial_norm',
+      )(single_embedding),
+      hm.LayerNorm(
+          use_fast_variance=False,
+          create_offset=False,
+          name='single_target_initial_norm',
+      )(target_cond),
+  ], axis=-1)
+  single_cond = hm.Linear(
+      self.config.conditioning.seq_channel,
+      use_bias=False,
+      precision='highest',
+      name='single_cond_initial_projection',
+  )(single_cond)
+
+  noise_embedding = noise_level_embeddings.noise_embeddings(
+      sigma_scaled_noise_level=noise_level / diffusion_head.SIGMA_DATA
+  )
+  single_cond += hm.Linear(
+      self.config.conditioning.seq_channel,
+      use_bias=False,
+      precision='highest',
+      name='noise_embedding_initial_projection',
+  )(
+      hm.LayerNorm(
+          use_fast_variance=False,
+          create_offset=False,
+          name='noise_embedding_initial_norm',
+      )(noise_embedding)
+  )
+
+  for idx in range(2):
+    single_cond += diffusion_transformer.transition_block(
+        single_cond, 2, self.global_config, name=f'single_transition_{idx}'
+    )
+  return single_cond, pair_cond
+
+
+def configure_v2_flash(config) -> bool:
+  """Configure and patch the AF3 JAX network for IntelliFold-v2-flash.
+
+  Enabled only by ``INTFOLD_FLASH=1``.  The transformer super-block size is
+  three so six PyTorch diffusion blocks map exactly to a 2x3 Haiku layer stack.
+  """
+  global _FLASH_PATCH_APPLIED
+  if os.environ.get('INTFOLD_FLASH') != '1':
+    return False
+  if os.environ.get('INTFOLD_FULLFAT') == '1':
+    raise ValueError('INTFOLD_FLASH=1 and INTFOLD_FULLFAT=1 are mutually exclusive')
+
+  _set_dotted(config, 'evoformer.pairformer.num_layer', 12)
+  _set_dotted(config, 'heads.diffusion.atom_transformer.num_blocks', 2)
+  _set_dotted(config, 'heads.diffusion.transformer.num_blocks', 6)
+  _set_dotted(config, 'heads.diffusion.transformer.super_block_size', 3)
+
+  if not _FLASH_PATCH_APPLIED:
+    from alphafold3.model.network import diffusion_head
+    import haiku as hk
+
+    diffusion_head.DiffusionHead._conditioning = hk.transparent(
+        _flash_conditioning
+    )
+    _FLASH_PATCH_APPLIED = True
+  print(
+      '[intellifold] model configured for v2-flash '
+      '(12 pairformer, 6 diffusion, 2 atom blocks; advanced conditioning)',
+      flush=True,
+  )
+  return True
