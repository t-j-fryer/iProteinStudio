+def empty_device_cache(device: torch.device | str | None = None) -> None:
+    """Release the active accelerator allocator without assuming CUDA."""
+    device_type = torch.device(device).type if device is not None else None
+    if device_type == "cuda" or (device_type is None and torch.cuda.is_available()):
+        torch.cuda.empty_cache()
+    elif device_type == "mps" or (
+        device_type is None and torch.backends.mps.is_available()
+    ):
+        torch.mps.empty_cache()
+
+
 def autocasting_disable_decorator(disable_casting):
     def func_wrapper(func):
         def new_func(*args, **kwargs):
